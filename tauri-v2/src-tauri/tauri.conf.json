{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoDecompiler",
  "version": "2.0.3",
  "identifier": "com.nanodev.nanodecompiler",
  "build": {
    "beforeDevCommand": "npm run build:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NanoDecompiler v2.0.3 (Tauri Native)",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../resources/icon.png"
    ]
  }
}