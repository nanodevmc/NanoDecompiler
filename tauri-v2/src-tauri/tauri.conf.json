{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoDecompiler",
  "version": "2.0.6",
  "identifier": "com.nanodev.nanodecompiler",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NanoDecompiler v2.0.6 (Tauri Native)",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
